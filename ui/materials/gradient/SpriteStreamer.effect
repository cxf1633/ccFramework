
CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        # 自定义参数
        width: { value: 0.1, editor: { tooltip: "光泽宽度" } }
        strength: { value: 1.2, editor: { tooltip: "光泽强度" } }
        speedScale: { value: 1.0, editor: { tooltip: "速度系数" } }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 v_color;
  out vec2 v_uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    v_color = a_color;
    v_uv0 = a_texCoord;

    return pos;
  }
}%


CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>
  #include <builtin/uniforms/cc-global>

  in vec4 v_color;

  #if USE_TEXTURE
    in vec2 v_uv0;
    #pragma builtin(local)
    layout(set = 2, binding = 11) uniform sampler2D cc_spriteTexture;
  #endif

  uniform ARGS{
    float width;
    float strength;
    float speedScale;
  };

  vec4 frag () {
    vec4 o = vec4(1, 1, 1, 1);
    o *= CCSampleWithAlphaSeparated(cc_spriteTexture, v_uv0);

    float time = cc_time.x * speedScale;
    float k = 0.2; // 斜率绝对值
    
    // 在Cocos Creator 3.8.2的UV坐标系中，v_uv0.y=0在顶部，v_uv0.y=1在底部
    // 创建一个随时间从上到下移动的参考Y坐标（从0到1循环）
    float lineY = mod(time, 1.0);
    
    // 计算当前像素的Y坐标与参考Y坐标的差值
    float diffY = v_uv0.y - lineY;
    
    // 使用斜率k将Y轴差值转换为X轴偏移
    // 这样可以实现倾斜的光泽效果
    float xOffset = diffY / k;
    
    // 检查当前像素的X坐标是否在光泽区域内
    // 当lineY从0增加到1时，光泽区域会从顶部向下移动到底部
    if (v_uv0.x >= xOffset && v_uv0.x <= xOffset + width) {
      o *= strength;
    }

    return o;
  }
}%